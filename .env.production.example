DOMAIN=api.example.com
POSTGRES_DB=mke
POSTGRES_USER=mke
POSTGRES_PASSWORD=replace-with-a-random-database-password

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
JWT_SIGNING_KEY=replace-with-a-different-64-character-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://operations.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_TIME_ZONE=Africa/Nairobi

DATABASE_URL=postgresql://mke:password@db:5432/mke
REDIS_URL=redis://redis:6379/0
ROUTING_API_URL=https://routing.example.com

SMS_BACKEND=http
SMS_API_URL=https://sms-provider.example.com/messages
SMS_API_KEY=replace-with-provider-api-key
SMS_SENDER_ID=MKE

MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_SHORTCODE=replace-with-paybill-or-till
MPESA_PASSKEY=replace-with-stk-passkey
MPESA_STK_CALLBACK_URL=https://api.example.com/api/v1/payments/webhooks/mpesa/stk/
MPESA_CALLBACK_TOKEN=replace-with-random-callback-token
